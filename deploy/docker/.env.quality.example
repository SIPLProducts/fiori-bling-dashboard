# MIS Portal — QUALITY environment
# Copy to deploy/docker/.env.quality and fill in real values. Never commit the real file.
#
# Generate secrets:
#   POSTGRES_PASSWORD          : openssl rand -hex 24
#   JWT_SECRET                 : openssl rand -hex 32   (min 32 chars)
#   REALTIME_SECRET_KEY_BASE   : openssl rand -hex 32
#   ANON_KEY / SERVICE_ROLE_KEY: JWTs signed with JWT_SECRET
#     payload anon        -> {"role":"anon","iss":"supabase","iat":...,"exp":...}
#     payload service_role-> {"role":"service_role","iss":"supabase","iat":...,"exp":...}
#     (use https://jwt.io or the supabase self-hosting key generator)

POSTGRES_PASSWORD=change-me-quality-db-password
JWT_SECRET=change-me-32-char-minimum-jwt-secret
REALTIME_SECRET_KEY_BASE=change-me-64-hex-chars

ANON_KEY=eyJ...anon-jwt...
SERVICE_ROLE_KEY=eyJ...service-role-jwt...

# Public URLs (Nginx front door for this environment)
SITE_URL=http://quality.siplproducts.com
API_EXTERNAL_URL=http://quality.siplproducts.com/supabase

# Frontend build-time variables (Vite inlines these into the bundle)
VITE_SUPABASE_URL=http://quality.siplproducts.com/supabase
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon-jwt...
VITE_SUPABASE_PROJECT_ID=mis-quality

# App server
PORT=3000
