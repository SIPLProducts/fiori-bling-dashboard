# Production SAP middleware — copy to /opt/MIS_Projects/Production/middleware/.env
# Never commit the real passwords, keys, or shared secret.
PORT=3010
APP_BASE_URL=http://10.10.4.165:9000/middleware
MIDDLEWARE_SHARED_SECRET=replace-with-a-long-random-secret
SAP_TIMEOUT_MS=600000

SAP_DEV_BASE_URL=http://10.10.4.18:8000
SAP_DEV_CLIENT=234
SAP_DEV_USER=replace-with-sap-user
SAP_DEV_PASSWORD=replace-with-sap-password
SAP_DEV_CA_CERT_PATH=

SAP_QUALITY_BASE_URL=
SAP_QUALITY_CLIENT=
SAP_QUALITY_USER=
SAP_QUALITY_PASSWORD=
SAP_QUALITY_CA_CERT_PATH=

SAP_PROD_BASE_URL=
SAP_PROD_CLIENT=
SAP_PROD_USER=
SAP_PROD_PASSWORD=
# Required only when the HTTPS SAP certificate uses a private/self-signed CA.
SAP_PROD_CA_CERT_PATH=/opt/MIS_Projects/Production/middleware/certs/sap-prod-ca.pem

SUPABASE_URL=http://127.0.0.1:9010
SUPABASE_SERVICE_ROLE_KEY=replace-with-production-service-role-key