# SAP middleware environment — the ONLY place SAP credentials live.
# Copy to .env NEXT TO server.mjs and keep it out of version control.
#
# Start it with either of these (both load this file):
#   npm start
#   node server.mjs

# Local listening port.
PORT=3008

# Public address the portal uses to reach THIS service. Not the same as PORT:
# it is the externally reachable URL (ngrok, LAN address or nginx path).
# Paste the same value into Administration -> SAP API Settings -> Middleware
# Configuration -> "Node.js middleware URL".
APP_BASE_URL=https://your-tunnel-or-host.example.com

# Portal backend URL used to retrieve public token-signing keys (JWKS).
# This is NOT the portal website URL and NOT the middleware/ngrok URL.
PORTAL_BACKEND_URL=https://your-project-backend.example.com

# Portal origins allowed to call this service (comma separated, no trailing /).
# These are the sites the browser loads the portal from — NOT this service's URL.
# Leaving this empty makes every browser call fail with "Failed to fetch".
ALLOWED_ORIGINS=https://mis.siplproducts.com,https://fiori-bling-dashboard.lovable.app,https://id-preview--27aeaa58-eb6a-4965-897d-c1097d9ba383.lovable.app,http://localhost:8080

# Outbound SAP request timeout in milliseconds.
SAP_TIMEOUT_MS=30000

# --- SAP DEV ---
SAP_DEV_BASE_URL=http://10.200.1.2:8000
SAP_DEV_CLIENT=100
SAP_DEV_USER=sipl_dev
SAP_DEV_PASSWORD=

# --- SAP QUALITY ---
SAP_QUALITY_BASE_URL=
SAP_QUALITY_CLIENT=200
SAP_QUALITY_USER=sipl_qm
SAP_QUALITY_PASSWORD=

# --- SAP PRODUCTION ---
SAP_PROD_BASE_URL=
SAP_PROD_CLIENT=300
SAP_PROD_USER=sipl_prd
SAP_PROD_PASSWORD=
