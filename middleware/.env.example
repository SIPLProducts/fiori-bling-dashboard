# SAP middleware environment — the ONLY place SAP credentials live.
# Copy to .env on the middleware server and keep it out of version control.

PORT=3008

# Portal token verification (Supabase JWT secret of the matching environment).
SUPABASE_JWT_SECRET=replace-with-jwt-secret

# Portal origins allowed to call this service (comma separated).
ALLOWED_ORIGINS=https://mis.siplproducts.com,http://10.200.1.10:3006

# Outbound SAP request timeout in milliseconds.
SAP_TIMEOUT_MS=30000

# --- SAP DEV ---
SAP_DEV_BASE_URL=http://10.200.1.2:8000
SAP_DEV_CLIENT=100
SAP_DEV_USER=sipl_dev
SAP_DEV_PASSWORD=

# --- SAP QUALITY ---
SAP_QUALITY_BASE_URL=
SAP_QUALITY_CLIENT=200
SAP_QUALITY_USER=sipl_qm
SAP_QUALITY_PASSWORD=

# --- SAP PRODUCTION ---
SAP_PROD_BASE_URL=
SAP_PROD_CLIENT=300
SAP_PROD_USER=sipl_prd
SAP_PROD_PASSWORD=
